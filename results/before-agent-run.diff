+"""Tests for T-03 substring matching on name and email (TS-01 to TS-05)."""
+
+import pytest
+from customer_search.models.customer import Customer
+from customer_search.repositories.customer_repository import InMemoryCustomerRepository
+from customer_search.services.search_service import CustomerSearchService
+
+
+@pytest.fixture
+def service():
+    customers = [
+        Customer(customer_id="1", name="John Smith", email="john.smith@example.com"),
+        Customer(customer_id="2", name="Johnny Brown", email="jbrown@example.com"),
+        Customer(customer_id="3", name="Alice Green", email="alice@example.com"),
+    ]
+    return CustomerSearchService(repository=InMemoryCustomerRepository(customers))
+
+
+def _ids(results):
+    return {r.customer_id for r in results}
+
+
+def test_ts01_full_name_search(service):
+    assert _ids(service.search("John Smith")) == {"1"}
+
+
+def test_ts02_partial_name_search(service):
+    assert _ids(service.search("John")) == {"1", "2"}
+
+
+def test_ts03_full_email_search(service):
+    assert _ids(service.search("john.smith@example.com")) == {"1"}
+
+
+def test_ts04_partial_email_search(service):
+    assert _ids(service.search("john.smith")) == {"1"}
+
+
+def test_ts05_no_match_returns_empty_result_set(service):
+    assert service.search("xyz123") == []
