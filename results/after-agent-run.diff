diff --git a/tests/test_search_matching.py b/tests/test_search_matching.py
new file mode 100644
index 0000000..e8ecd4d
--- /dev/null
+++ b/tests/test_search_matching.py
@@ -0,0 +1,35 @@
+"""Tests for T-03 substring matching on name and email (TS-01..TS-05).
+
+Queries use the same letter case as the stored data: case sensitivity is open (Q-03).
+"""
+
+import pytest
+from customer_search.models.customer import Customer
+from customer_search.repositories.customer_repository import InMemoryCustomerRepository
+from customer_search.services.search_service import CustomerSearchService
+
+CUSTOMERS = [
+    Customer(customer_id="1", name="John Smith", email="john.smith@example.com"),
+    Customer(customer_id="2", name="Johnny Brown", email="jbrown@example.com"),
+    Customer(customer_id="3", name="Alice Green", email="alice@example.org"),
+]
+
+
+def search_ids(query):
+    service = CustomerSearchService(repository=InMemoryCustomerRepository(CUSTOMERS))
+    return {r.customer_id for r in service.search(query)}
+
+
+@pytest.mark.parametrize(
+    "scenario, query, expected",
+    [
+        ("TS-01 full name", "John Smith", {"1"}),
+        ("TS-02 partial name", "John", {"1", "2"}),
+        ("TS-03 full email", "john.smith@example.com", {"1"}),
+        ("TS-04 partial email", "john.smith", {"1"}),
+        ("TS-05 no match", "xyz123", set()),
+    ],
+)
+def test_search_returns_only_matching_customers(scenario, query, expected):
+    # Sets, not lists: relevance order is open (Q-02).
+    assert search_ids(query) == expected
